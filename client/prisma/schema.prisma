// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([name])
}


model Question {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  question  String
  answer    String

  lesson    Lesson  @relation(fields: [lessonId], references: [id])
}

enum BlockType {
  TEXT
  IMAGE
  VIDEO
  ANIMATION
}

model LessonBlock {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  order     Int

  type      BlockType

  text      String?
  imageUrl  String?
  videoUrl  String?
  animation Json?

  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([lessonId, order])
}


model Lesson {
  id        Int           @id @default(autoincrement())
  title     String
  thumbnail String
  blocks    LessonBlock[]
  questions Question[]
}

model User {
    id Int @id @default(autoincrement())
    username      String
    password      String
    mail          String @unique
    image         String?
    completed     Int[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}